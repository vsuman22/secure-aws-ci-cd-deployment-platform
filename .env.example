# Flask application configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=true
APP_PORT=5000

# Use a long random value locally. Never commit the real value in .env.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Reserved for later phases.
# Do not add real AWS credentials here.
AWS_REGION=ap-south-1

# Reserved for later deployment configuration.
DEPLOYMENT_ENV=development
